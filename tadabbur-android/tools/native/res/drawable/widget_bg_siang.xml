<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#3FA7FF" android:endColor="#CDEBFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:gravity="top|end" android:end="6dp" android:top="2dp">
        <shape android:shape="oval">
            <size android:width="96dp" android:height="96dp" />
            <gradient android:type="radial" android:gradientRadius="48dp" android:centerColor="#99FFF176" android:endColor="#00FFF176" />
        </shape>
    </item>
    <item android:gravity="top|end" android:end="32dp" android:top="26dp">
        <shape android:shape="oval">
            <size android:width="44dp" android:height="44dp" />
            <solid android:color="#FFE45C" />
        </shape>
    </item>
    <item android:gravity="bottom|start" android:start="22dp" android:bottom="12dp">
        <shape android:shape="oval">
            <size android:width="78dp" android:height="24dp" />
            <solid android:color="#80FFFFFF" />
        </shape>
    </item>
    <item android:gravity="bottom|end" android:end="70dp" android:bottom="22dp">
        <shape android:shape="oval">
            <size android:width="56dp" android:height="18dp" />
            <solid android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>
