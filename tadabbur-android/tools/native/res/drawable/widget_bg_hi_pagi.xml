<?xml version="1.0" encoding="utf-8"?>
<!-- khusus widget 4x3, cuaca cerah pagi: matahari dipindah ke kanan jam besar (di bawah baris atas), tidak lagi di dasar widget di belakang jadwal sholat -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#1E2F5E" android:centerColor="#8A4F86" android:endColor="#C4623F" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- cahaya matahari -->
    <item android:gravity="top|end" android:end="28dp" android:top="34dp">
        <shape android:shape="oval">
            <size android:width="84dp" android:height="84dp" />
            <gradient android:type="radial" android:gradientRadius="42dp" android:centerColor="#B3FFC857" android:endColor="#00FFC857" />
        </shape>
    </item>
    <!-- matahari -->
    <item android:gravity="top|end" android:end="44dp" android:top="50dp">
        <shape android:shape="oval">
            <size android:width="52dp" android:height="52dp" />
            <solid android:color="#FFD36B" />
        </shape>
    </item>
    <!-- tanah di dasar widget -->
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <size android:height="26dp" />
            <solid android:color="#2A1E4A" />
            <corners android:bottomLeftRadius="22dp" android:bottomRightRadius="22dp" />
        </shape>
    </item>
</layer-list>
