<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hi_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="6dp"
    android:background="@drawable/widget_bg">

    <!-- baris atas: tanggal Hijriah (kiri), tombol refresh, dan waktu terbit/terbenam (paling kanan) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/hi_hijri"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:textSize="8dp" />
        <TextView
            android:id="@+id/hi_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="&#8635;"
            android:textStyle="bold"
            android:textSize="18dp" />
        <LinearLayout
            android:id="@+id/hi_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="9dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">
            <ImageView
                android:id="@+id/hi_ikon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="4dp"
                android:scaleType="fitCenter" />
            <TextView
                android:id="@+id/hi_matahari"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:textSize="13dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- jam besar dan tanggal; TextClock berdetak sendiri tiap menit -->
    <TextClock
        android:id="@+id/hi_jam"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:fontFamily="sans-serif-thin"
        android:textSize="64dp" />
    <TextClock
        android:id="@+id/hi_tgl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-10dp"
        android:includeFontPadding="false"
        android:format12Hour="EEE, d MMM"
        android:format24Hour="EEE, d MMM"
        android:fontFamily="sans-serif-medium"
        android:textSize="16dp" />

    <!-- ayat: mengisi sisa tinggi widget; bila ayat panjang, bagian ini yang terpotong, bukan jadwal sholat -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView
            android:id="@+id/hi_arab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="20dp" />
        <TextView
            android:id="@+id/hi_arti"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:textSize="9dp" />
        <TextView
            android:id="@+id/hi_ref"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:fontFamily="serif"
            android:textSize="7dp" />
    </LinearLayout>

    <!-- jadwal sholat: 3 kolom x 2 baris -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/hi_s0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="left" android:maxLines="1" android:fontFamily="serif" android:textSize="10dp" />
        <TextView android:id="@+id/hi_s1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:maxLines="1" android:fontFamily="serif" android:textSize="10dp" />
        <TextView android:id="@+id/hi_s2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="right" android:maxLines="1" android:fontFamily="serif" android:textSize="10dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/hi_s3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="left" android:maxLines="1" android:fontFamily="serif" android:textSize="10dp" />
        <TextView android:id="@+id/hi_s4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:maxLines="1" android:fontFamily="serif" android:textSize="10dp" />
        <TextView android:id="@+id/hi_s5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="right" android:maxLines="1" android:fontFamily="serif" android:textSize="10dp" />
    </LinearLayout>

    <!-- waktu makruh: satu baris penuh -->
    <TextView
        android:id="@+id/hi_extra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:maxLines="1"
        android:fontFamily="serif"
        android:textSize="8dp" />
</LinearLayout>
